<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeerRdp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryVariant">#003c8f</item>
        <item name="colorSecondary">#00838F</item>

        <!-- targetSdk 37 强制边到边，状态栏透明后浅色图标压在白色背景上不可见，
             这里显式声明浅色主题下使用深色状态栏/导航栏图标 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
